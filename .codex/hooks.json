{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LORE_AGENT_NAME=Codex lore hooks wakeup",
            "statusMessage": "Loading Lore context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LORE_AGENT_NAME=Codex lore hooks autosave",
            "timeout": 30,
            "statusMessage": "Saving Lore context"
          }
        ]
      }
    ]
  }
}
