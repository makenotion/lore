node_modules/
dist/
*.tsbuildinfo

# Environment
.env
.env.local

# .lore.yaml is ignored to keep personal vault page IDs and tokens out of
# version control. Copy .lore.example.yaml to .lore.yaml locally and fill
# in your own pageId; the pre-commit guard rejects any staged .lore.yaml.
.lore.yaml

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Per-developer Claude Code state. `lore install` writes hooks under
# `~/.claude/projects/<encoded>/settings.json` (the per-user-per-project
# location), so a project-scoped `.claude/settings.json` here is whatever
# Claude Code itself generates locally for the operator and is not part of
# the committed integration surface. `settings.local.json` carries the
# per-developer Bash() permission allowlist.
.claude/settings.json
.claude/settings.local.json

# Ad-hoc / empirical verification scripts — intentionally not part of the
# build or test surface. Use for one-off Notion API experiments.
scripts/

# Local eval run artifacts. Commit suite and memory fixtures, not generated
# run output.
evals/results/

# Defensive: the autosave-learning dedup lock dir lives under
# `LORE_HOOK_STATE_DIR` (default: tmpdir). An interim version of the dedup
# code wrote into cwd; this guard keeps any future regression from
# leaking lock state into the repo.
autosave-learning-locks/
