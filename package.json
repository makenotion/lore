{
  "name": "@makenotion/lore",
  "version": "0.16.0",
  "description": "AI memory system backed by Notion",
  "type": "module",
  "bin": {
    "lore": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    }
  },
  "files": [
    ".lore.example.yaml",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "dist",
    "docs",
    "evals/vaults.yaml",
    "hooks",
    "profiles",
    "src/auth/AGENTS.md",
    "src/cli/AGENTS.md",
    "src/core/AGENTS.md",
    "src/hooks/AGENTS.md",
    "src/mcp/AGENTS.md",
    "src/notion/AGENTS.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version:check": "node tools/check-version-sync.mjs",
    "test:watch": "vitest",
    "mcp": "node dist/mcp.js",
    "prepare": "npm run build && node tools/install-git-hooks.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@notionhq/client": "^5.1.0",
    "commander": "^13.1.0",
    "entities": "^8.0.0",
    "p-limit": "^6.2.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Notion Labs, Inc.",
  "keywords": [
    "notion",
    "mcp",
    "claude-code",
    "cursor"
  ],
  "homepage": "https://github.com/makenotion/lore#readme",
  "bugs": {
    "url": "https://github.com/makenotion/lore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makenotion/lore.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
