{
  "mcpServers": {
    "lore": {
      "command": "node",
      "args": [
        "${HOME}/.lore/dist/mcp.js"
      ],
      "cwd": "${HOME}/.lore",
      "env": {
        "LORE_NOTION_BASE_URL": "${LORE_NOTION_BASE_URL}",
        "LORE_CONFIG_ROOT": "${HOME}/.lore",
        "LORE_SUPPRESS_DEPRECATIONS": "1"
      }
    }
  }
}
